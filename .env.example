# ===== 数据库 / 队列 =====
# 应用层用 asyncpg（异步）
DATABASE_URL=postgresql+asyncpg://acquisition:acquisition_dev@localhost:5433/acquisition
# alembic 迁移用 psycopg2（同步）
DATABASE_URL_SYNC=postgresql+psycopg2://acquisition:acquisition_dev@localhost:5433/acquisition
REDIS_URL=redis://localhost:6379/0

# ===== Apify =====
# https://console.apify.com/account/integrations 获取
APIFY_API_TOKEN=your_apify_token_here

# ===== LLM（OpenAI 兼容接入，默认 DeepSeek）=====
# https://platform.deepseek.com → API Keys
LLM_API_KEY=your_deepseek_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 应用 =====
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
